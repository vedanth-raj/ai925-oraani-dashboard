# AI925 & Oraani Order Management System - Environment Configuration Template
# Copy this file to .env and fill in your values if needed.

# -------------------------------------------------------------
# NGROK TUNNEL CONFIGURATION (Optional - for live public URL)
# -------------------------------------------------------------
# 1. Sign up for free at: https://dashboard.ngrok.com
# 2. Get your free Authtoken at: https://dashboard.ngrok.com/get-started/your-authtoken
# 3. Paste your token here:
NGROK_AUTHTOKEN=

# 4. Optional: Free permanent static domain from https://dashboard.ngrok.com/domains
# Example: NGROK_DOMAIN=your-assigned-domain.ngrok-free.app
NGROK_DOMAIN=

PORT=3000
NODE_ENV=production
